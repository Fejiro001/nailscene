{{ 'nailscene-archive.css' | asset_url | stylesheet_tag }}

<section class="nailscene-archive">
  <div class="nailscene-archive__window">
    <div class="nailscene-archive__titlebar">
      <span>✦ NAILSCENE.EXE / SCENE ARCHIVE</span>
      <span aria-hidden="true">🗕 🗖 ✖</span>
    </div>

    <div class="nailscene-archive__body">
      <header class="nailscene-archive__heading">
        <p>CURRENT DIRECTORY / ARCHIVE</p>
        <h1>{{ section.settings.heading | escape }}</h1>
        <p>{{ section.settings.subtitle | escape }}</p>
      </header>

      <div class="nailscene-archive__grid">
        {% for block in section.blocks %}
          {% assign scene = block.settings.collection %}

          {% if scene != blank %}
            {% assign folder_title = scene.metafields.custom.folder_title.value | default: scene.title %}

            {% assign available_count = 0 %}
            {% for product in scene.products %}
              {% if product.available %}
                {% assign available_count = available_count | plus: 1 %}
              {% endif %}
            {% endfor %}

            <article class="nailscene-archive__card" {{ block.shopify_attributes }}>
              <a
                href="{{ scene.url }}?view=archive-entry"
                class="nailscene-archive__link"
              >
                <div class="nailscene-archive__folder">
                  <span>✦ {{ folder_title | escape }}</span>
                  <span aria-hidden="true">🗖</span>
                </div>

                <div class="nailscene-archive__preview">
                  {% if scene.products_count > 0 %}
                    {% for product in scene.products limit: 3 %}
                      {% if product.featured_image %}
                        {{
                          product.featured_image
                          | image_url: width: 360
                          | image_tag: loading: 'lazy', alt: product.title
                        }}
                      {% endif %}
                    {% endfor %}
                  {% elsif scene.image %}
                    {{ scene.image | image_url: width: 500 | image_tag: loading: 'lazy', alt: scene.title }}
                  {% else %}
                    <span class="nailscene-archive__empty-icon" aria-hidden="true">✧</span>
                  {% endif %}
                </div>

                <div class="nailscene-archive__details">
                  <span>{{ scene.products_count }} FILES</span>

                  {% if available_count > 0 %}
                    <span class="is-online">STATUS: ONLINE ✦</span>
                  {% else %}
                    <span class="is-offline">STATUS: OFFLINE ✦</span>
                  {% endif %}
                </div>

                <span class="nailscene-archive__open"> OPEN FOLDER → </span>
              </a>
            </article>
          {% endif %}
        {% endfor %}
      </div>

      {% if section.blocks.size == 0 %}
        <p class="nailscene-archive__message">NO SCENES DETECTED // ADD A COLLECTION TO THE ARCHIVE</p>
      {% endif %}
    </div>

    <div class="nailscene-archive__statusbar">
      <span>NAILSCENE.EXE / ARCHIVE DIRECTORY</span>
      <span>{{ section.blocks.size }} FOLDERS CONFIGURED</span>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "NailScene Archive",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "SCENE ARCHIVE"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "PREVIOUS SCENES // PRESERVED FILES"
    }
  ],
  "blocks": [
    {
      "type": "scene",
      "name": "Scene Folder",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Scene collection"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "NailScene Archive"
    }
  ]
}
{% endschema %}
