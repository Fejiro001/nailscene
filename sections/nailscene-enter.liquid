{{ 'nailscene-enter.css' | asset_url | stylesheet_tag }}

<section class="nailscene-enter">
  <div class="nailscene-enter__container">
    <div class="nailscene-enter__content">
      <div class="nailscene-enter__heading">
        <h2>{{ section.settings.heading | escape }}</h2>
      </div>

      <div class="nailscene-enter__description">
        {{ section.settings.description }}
      </div>

      <a
        href="{{ section.settings.button_link | default: routes.root_url }}"
        class="nailscene-retro-button nailscene-enter__button"
      >
        {{ section.settings.button_label | escape }}
        <span aria-hidden="true">→</span>
      </a>
    </div>

    <div class="nailscene-enter__window">
      <div class="nailscene-enter__titlebar">
        <span>✿ NAILSCENE.EXE</span>
        <span class="nailscene-enter__controls" aria-hidden="true">🗕 🗖 ✖</span>
      </div>

      <div class="nailscene-enter__window-content">
        <img
          src="{{ 'nailscene-cd.png' | asset_url }}"
          alt=""
          class="nailscene-enter__cd"
          loading="lazy"
          width="240"
          height="240"
        >

        <ul class="nailscene-enter__list">
          <li><span>★</span> currently online</li>
          <li><span>✿</span> new files</li>
          <li><span>✦</span> limited drops</li>
          <li><span>◆</span> your next set</li>
        </ul>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "NailScene Enter",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "WELCOME TO THE SCENE"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>NailScene is your digital destination for statement-making press-ons, limited drops and sets made to become the scene.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "DISCOVER NAILSCENE"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    }
  ],
  "presets": [
    {
      "name": "NailScene Enter"
    }
  ]
}
{% endschema %}
