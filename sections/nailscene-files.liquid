{{ 'nailscene-files.css' | asset_url | stylesheet_tag }}

{% assign files_collection = section.settings.collection %}

<section class="nailscene-files">
  <div class="nailscene-files__window">
    <div class="nailscene-files__window-bar">
      <div class="nailscene-files__window-title">
        <span class="nailscene-files__window-icon">✿</span>
        <span>NAILSCENE.EXE / SCENE FILES</span>
      </div>

      {% render 'nailscene-window-controls' %}
    </div>

    <div class="nailscene-files__container">
      <header class="nailscene-files__heading">
        {% assign scene_collection = collections['scene-files'] %}

        {% assign folder_title = scene_collection.metafields.custom.folder_title.value
          | default: 'SCENE_001 // THE FIRST FOLDER'
        %}

        {% assign folder_parts = folder_title | split: ' // ' %}
        <h2>
          {{ folder_parts[0] | escape }}

          {% if folder_parts.size > 1 %}
            <span>// {{ folder_parts[1] | escape }}</span>
          {% endif %}
        </h2>

        <p>
          {% if files_collection != blank %}
            {{ files_collection.products_count }}
          {% else %}
            0
          {% endif %}
          FILES DETECTED
        </p>
      </header>

      <div class="nailscene-files__grid">
        {% if files_collection != blank and files_collection.products_count > 0 %}
          {% for product in files_collection.products limit: section.settings.product_limit %}
            <article class="nailscene-file">
              <div class="nailscene-file__titlebar">
                <span>✿ FILE_{{ forloop.index }}</span>
                {% render 'nailscene-window-controls' %}
              </div>

              <div class="nailscene-file__details">
                <p class="nailscene-file__number">FILE_{{ forloop.index | prepend: '00' | slice: -3, 3 }}</p>

                <h3>
                  <a href="{{ product.url }}">
                    {{ product.title | upcase | escape }}
                  </a>
                </h3>

                {% render 'nailscene-product-status', product: product, class_name: 'nailscene-file__status' %}
              </div>

              <a href="{{ product.url }}" class="nailscene-file__image">
                {% if product.featured_image != blank %}
                  {{
                    product.featured_image
                    | image_url: width: 800
                    | image_tag:
                      loading: 'lazy',
                      widths: '300, 500, 800',
                      sizes: '(min-width: 990px) 30vw, (min-width: 750px) 45vw, 90vw'
                  }}
                {% else %}
                  {{ 'product-1' | placeholder_svg_tag }}
                {% endif %}
              </a>

              <div class="nailscene-file__footer">
                <p>{{ product.price | money }}</p>

                <a href="{{ product.url }}"> VIEW FILE <span aria-hidden="true">→</span> </a>
              </div>
            </article>
          {% endfor %}

        {% else %}
          <p class="nailscene-files__empty">NO FILES DETECTED // NEW SETS COMING SOON</p>
        {% endif %}
      </div>
    </div>

    <div class="nailscene-files__window-bottom">
      <span>NAILSCENE © 2026</span>
      <span> {{ files_collection.products_count | default: 0 }} FILES // SYSTEM ONLINE ✦ </span>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "NailScene Files",
  "settings": [
    {
      "type": "collection",
      "id": "collection",
      "label": "Product collection"
    },
    {
      "type": "range",
      "id": "product_limit",
      "label": "Number of products",
      "min": 3,
      "max": 12,
      "step": 1,
      "default": 3
    }
  ],
  "presets": [
    {
      "name": "NailScene Files"
    }
  ]
}
{% endschema %}
