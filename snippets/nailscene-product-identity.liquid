{% liquid
  assign file_label = product.metafields.custom.file_label.value
  assign folder_title = 'SCENE_001 // THE FIRST FOLDER'

  for scene_collection in product.collections
    if scene_collection.metafields.custom.folder_title.value != blank
      assign folder_title = scene_collection.metafields.custom.folder_title.value
      break
    endif
  endfor

  assign restocking = product.metafields.custom.restocking.value
  assign restock_date = product.metafields.custom.restock_date.value
%}

{% if file_label != blank %}
  <p class="nailscene-product__file-label">
    {{ file_label | escape }}
  </p>
{% endif %}

<div class="product__title" {{ block.shopify_attributes }}>
  <h1>{{ product.title | escape }}</h1>
</div>

<p class="nailscene-product__folder">
  {{ folder_title | escape }}
</p>

{% render 'nailscene-product-status', product: product, class_name: 'nailscene-product__status' %}

{% unless product.available %}
  {% render 'nailscene-unavailable-panel', product: product %}
{% endunless %}
